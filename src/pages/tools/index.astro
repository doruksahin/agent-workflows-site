---
import Base from '../../layouts/Base.astro';
import tools from '../../data/tools.json';
import ToolCard from '../../components/ToolCard.astro';
const groups=[...new Set(tools.map(t=>t.group))];
---
<Base title="Tools & repositories" description="Explore the tools visually, open their GitHub repositories, and reveal inputs, outputs, and exact source references.">
<div class="shell">
  <div class="page-head"><div class="eyebrow">10 components / 9 repositories</div><h1>Find the tool.<br /><em>Follow the source.</em></h1><p class="lead">A quick overview first. Open a tool’s details when you need the handoffs, instructions, or source behind it.</p></div>
  <nav class="group-nav" aria-label="Tool categories">{groups.map((group,i)=><a href={'#group-'+i}>{group}</a>)}<a href="/map/">Explore the map ↗</a></nav>
  <div id="repositories">{groups.map((group,i)=><section class="catalog-group" id={'group-'+i}><h2>{group}<span>{tools.filter(t=>t.group===group).length.toString().padStart(2,'0')}</span></h2><div class="repo-grid">{tools.filter(t=>t.group===group).map(t=><ToolCard tool={t}/>)}</div></section>)}</div>
</div>
</Base>
