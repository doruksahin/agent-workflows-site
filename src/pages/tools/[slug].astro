---
import Base from '../../layouts/Base.astro';
import tools from '../../data/tools.json';
export function getStaticPaths(){return tools.map(tool=>({params:{slug:tool.slug},props:{tool}}))}
const {tool:t}=Astro.props;
const base='https://github.com/'+t.repo+'/blob/'+t.commit+'/'+(t.path?t.path+'/':'');
---
<Base title={t.name} description={t.summary}><div class="shell"><div class="page-head"><div class="breadcrumb"><a href="/tools/">Tools</a> / {t.group}</div><div class="eyebrow">{t.kind}</div><h1>{t.name}</h1><p class="lead">{t.summary}</p></div><div class="detail"><article class="prose"><h2>When to reach for it</h2><p>{t.when}</p><div class="inout"><div><h3>Input</h3><p>{t.input}</p></div><div><h3>Output</h3><p>{t.output}</p></div></div><h2>What happens</h2><p>{t.how}</p><h2>Where its responsibility ends</h2><p>{t.boundary}</p><h2>Get started</h2><p>{t.start}</p><p><a href={base+t.files[0]}>Read the owner’s instructions ↗</a>{!t.public && <small> — repository access required</small>}</p><h2>Connected tools</h2><ul>{t.related.map(slug=>{const item=tools.find(x=>x.slug===slug)!;return <li><a href={'/tools/'+slug+'/'}>{item.name}</a> — {item.summary}</li>})}</ul></article><aside class="source-box" aria-label="Source references"><div class:list={['badge',{'private':!t.public}]}>{t.public?'Public source':'Private source'}</div><h2 style="margin-top:20px">Follow the source</h2><p>{t.repo}</p>{t.files.map(file=><a class="source-file" href={base+file}>{(t.path?t.path+'/':'')+file} ↗</a>)}<hr/><p>Reviewed snapshot</p><a class="commit" href={'https://github.com/'+t.repo+'/commit/'+t.commit}>{t.commit.slice(0,12)} ↗</a><p>Checked 17 September 2026 against the workspace’s recorded source revision.</p>{!t.public && <p>These source links require repository access. No installation access is granted by this guide.</p>}<a class="text-link" href="/about/">How references work →</a></aside></div></div></Base>
