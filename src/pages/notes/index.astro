---
import Base from '../../layouts/Base.astro';
import NoteCard from '../../components/NoteCard.astro';
import NoteTree from '../../components/NoteTree.astro';
import { publishedNotes, noteTags, noteTree } from '../../lib/notes';
const notes = await publishedNotes();
---
<Base title="Notes" description="Learned experience from building and running agent workflows: setups, diagnoses, and what worked."><div class="shell"><div class="page-head"><div class="eyebrow">Notes</div><h1>What the work<br /><em>taught us.</em></h1><p class="lead">Setups, diagnoses, and lessons from building and running agent workflows.</p><div class="tag-list">{noteTags(notes).map(t => <a class="badge" href={`/notes/tags/${t}/`}>{t}</a>)}</div></div>
<div class="note-tabs" role="tablist" aria-label="Notes view" hidden><button type="button" role="tab" id="tab-latest" aria-controls="latest" aria-selected="true">Latest</button><button type="button" role="tab" id="tab-files" aria-controls="files" aria-selected="false" tabindex="-1">Files</button></div>
<section id="latest" class="note-panel"><h2 class="eyebrow">Latest</h2><div class="guide-grid">{notes.map(note => <NoteCard note={note} />)}</div></section>
<section id="files" class="note-panel"><h2 class="eyebrow">Files</h2><div class="note-files"><NoteTree dir={noteTree(notes)} /></div></section></div>
<script is:inline>(()=>{const list=document.querySelector('.note-tabs'),tabs=[...list.querySelectorAll('[role=tab]')],key='notes-view';const show=(id,focus)=>{for(const t of tabs){const on=t.getAttribute('aria-controls')===id;t.setAttribute('aria-selected',on);t.tabIndex=on?0:-1;document.getElementById(t.getAttribute('aria-controls')).hidden=!on;if(on&&focus)t.focus()}};const pick=()=>{const h=location.hash.slice(1);if(h==='latest'||h==='files')return h;try{const s=localStorage.getItem(key);if(s==='latest'||s==='files')return s}catch{}return 'latest'};const choose=(id,focus)=>{show(id,focus);try{localStorage.setItem(key,id)}catch{}history.replaceState(null,'','#'+id)};for(const t of tabs){const p=document.getElementById(t.getAttribute('aria-controls'));p.setAttribute('role','tabpanel');p.setAttribute('aria-labelledby',t.id)}list.hidden=false;list.parentElement.classList.add('tabbed');show(pick());tabs.forEach((t,i)=>{t.addEventListener('click',()=>choose(t.getAttribute('aria-controls')));t.addEventListener('keydown',e=>{const d={ArrowRight:1,ArrowLeft:-1}[e.key];if(d){e.preventDefault();choose(tabs[(i+d+tabs.length)%tabs.length].getAttribute('aria-controls'),true)}})});addEventListener('hashchange',()=>show(pick()))})();</script></Base>
