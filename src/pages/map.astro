---
import Base from '../layouts/Base.astro';
import tools from '../data/tools.json';
---
<Base title="The system map" description="A full-page interactive Archify map of the agent workflow ecosystem, with GitHub repository references." immersive>
  <div class="map-workspace">
    <header class="map-toolbar"><a class="map-back" href="/" aria-label="Back to Agent Workflows"><img src="/favicon.svg" width="28" height="28" alt=""/><span>Agent Workflows</span></a><span class="map-toolbar-title">System map</span><div class="map-controls"><a href="/tools/">Tools & repos</a><a href="/downloads/agent-workflows.html" download>Download HTML ↓</a><details class="map-sources"><summary>GitHub references <span aria-hidden="true">+</span></summary><div class="map-source-drawer"><div class="eyebrow">Components → source</div>{tools.map(t=><div class="map-source-item"><a href={'/tools/'+t.slug+'/'}>{t.name} →</a><a href={'https://github.com/'+t.repo}>{t.repo} ↗</a><details><summary>Reviewed files</summary>{t.files.map(f=><a href={'https://github.com/'+t.repo+'/blob/'+t.commit+'/'+(t.path?t.path+'/':'')+f}>{f} ↗</a>)}</details></div>)}<p class="reference-note">Snapshot: 17 Sep 2026. Private links require repository access. <a href="/about/">About the sources</a></p></div></details></div></header>
    <iframe class="map-canvas" src="/maps/agent-workflows.html" title="Interactive Agent Workflows architecture map" sandbox="allow-scripts allow-downloads"></iframe>
  </div>
</Base>
