---
import { render } from 'astro:content';
import Note from '../../layouts/Note.astro';
import NoteTree from '../../components/NoteTree.astro';
import { noteTree, treeFolders, noteSource, publishedEntries, type Note as Entry, type TreeFolder } from '../../lib/entries';
export async function getStaticPaths() {
  const entries = await publishedEntries();
  const tree = noteTree(entries);
  return [
    ...treeFolders(tree).filter(f => f.rel).map(folder => ({ params: { path: folder.rel }, props: { tree, folder } })),
    ...entries.map(note => ({ params: { path: note.id }, props: { tree, note } })),
  ];
}
interface Props { tree: TreeFolder; folder?: TreeFolder; note?: Entry }
const { tree, folder, note } = Astro.props;
const rel = folder ? folder.rel : noteSource(note!);
const parts = rel.split('/');
const crumbs = [{ name: 'Knowledge base', url: '/knowledge-base/' }, ...parts.map((name, i) => ({ name, url: i === parts.length - 1 && !folder ? Astro.url.pathname : `/knowledge-base/${parts.slice(0, i + 1).join('/')}/` }))];
// The glob loader logs a Markdown render error (such as a broken relative link) and continues; fail instead.
if (note && note.filePath!.endsWith('.md') && !note.rendered) throw new Error(`${note.filePath} did not render; see the [glob-loader] error above`);
const Content = note ? (await render(note)).Content : null;
const title = note?.data.title ?? `${folder!.name}/`;
const description = note?.data.summary ?? `Files in knowledge-base/${rel}/.`;
---
<Note tree={tree} current={Astro.url.pathname} crumbs={crumbs} title={title} description={description} note={note}>
  {folder && <div slot="listing" class="folder-tree"><NoteTree dir={folder} current={Astro.url.pathname} searchable /></div>}
  {Content && <Content />}
</Note>
