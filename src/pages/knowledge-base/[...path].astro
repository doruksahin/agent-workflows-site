---
import { render } from 'astro:content';
import Note from '../../layouts/Note.astro';
import { galleryImages, noteTree, treeFolders, noteSource, publishedEntries, type Note as Entry, type TreeFolder } from '../../lib/entries';
import { isImage, isReadme } from '../../../scripts/note-paths.mjs';
export async function getStaticPaths() {
  const entries = await publishedEntries();
  const tree = noteTree(entries);
  return [
    ...treeFolders(tree).filter(f => f.rel).map(folder => ({ params: { path: folder.rel }, props: { tree, folder, note: folder.readme } })),
    ...entries.filter(n => !isReadme(noteSource(n))).map(note => ({ params: { path: note.id }, props: { tree, note } })),
  ];
}
interface Props { tree: TreeFolder; folder?: TreeFolder; note?: Entry }
const { tree, folder, note } = Astro.props;
const rel = folder ? folder.rel : noteSource(note!);
const parts = rel.split('/');
const crumbs = [{ name: 'Knowledge base', url: '/knowledge-base/' }, ...parts.map((name, i) => ({ name, url: i === parts.length - 1 && !folder ? Astro.url.pathname : `/knowledge-base/${parts.slice(0, i + 1).join('/')}/` }))];
// The glob loader logs a Markdown render error (such as a broken relative link) and continues; fail instead.
if (note && note.filePath!.endsWith('.md') && !note.rendered) throw new Error(`${note.filePath} did not render; see the [glob-loader] error above`);
const Content = note ? (await render(note)).Content : null;
const title = note?.data.title ?? `${folder!.name}/`;
const description = note?.data.summary ?? `Files in knowledge-base/${rel}/.`;
const images = folder ? await galleryImages(folder) : [];
const others = folder ? folder.children.filter(c => !(c.kind === 'file' && isImage(c.rel))) : [];
---
<Note tree={tree} current={Astro.url.pathname} crumbs={crumbs} title={title} description={description} note={note}>
  {folder && !note?.data.verbatim && <Fragment slot="listing">
    {images.length > 0 && <ul class="gallery" aria-label="Images">{images.map(({ file, meta, format, thumb }) => <li id={file.name}><a class="gallery-card" href={file.url} data-viewer-item data-name={file.name} data-meta={meta}><img src={thumb.src} width={thumb.width} height={thumb.height} alt="" loading="lazy" decoding="async" /><span class="gallery-name">{file.name}</span><span class="gallery-meta"><span class="badge">{format}</span><span>{meta}</span></span></a><template>{file.usedIn.map(u => <a href={u.url}>{u.name}</a>)}</template></li>)}</ul>}
    {others.length > 0 && <ul class="note-list">{others.map(c => <li><a href={c.kind === 'folder' ? c.url : c.href}>{c.name}{c.kind === 'folder' && '/'}</a><span>{c.kind === 'folder' ? 'Folder' : c.kind === 'doc' ? c.note!.data.title : c.name.split('.').pop()!.toUpperCase()}</span></li>)}</ul>}
  </Fragment>}
  {Content && <Content />}
</Note>
