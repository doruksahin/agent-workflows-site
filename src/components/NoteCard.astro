---
import { formatDate, noteFolder, notePath, type Note } from '../lib/notes';
interface Props { note: Note }
const { note } = Astro.props;
const folder = noteFolder(note);
---
<a class="guide-teaser" href={notePath(note)} data-note={note.id}><span class="eyebrow"><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time> · {note.data.tags.join(' · ')}</span>{folder && <span class="path-chip">{folder}/</span>}<h3>{note.data.title}</h3><p>{note.data.summary}</p><span class="go">Read the note →</span></a>
