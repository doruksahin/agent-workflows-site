---
import { formatDate, notePath, type Note } from '../lib/notes';
interface Props { note: Note }
const { note } = Astro.props;
---
<a class="guide-teaser" href={notePath(note)} data-note={note.id} data-tags={note.data.tags.join(' ')}><span class="eyebrow"><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time></span><span class="card-tags">{note.data.tags.map(t => <span class="badge" data-card-tag={t}>{t}</span>)}</span><h3>{note.data.title}</h3><p>{note.data.summary}</p></a>
