---
import type { TreeFolder } from '../lib/notes';
interface Props { dir: TreeFolder; current?: string; searchable?: boolean }
const { dir, current, searchable } = Astro.props;
const here = (url: string) => url === current ? 'page' : undefined;
---
{searchable ? <div class="note-tree-search"><div class="tree-bar"><input type="search" autocomplete="off" spellcheck="false" placeholder="Search files" aria-label="Search files" /><div class="tree-actions" role="group" aria-label="Expand or collapse folders" hidden><button type="button" class="tree-btn" data-tree="expand"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4-3 4 3M4 10l4 3 4-3"/></svg>Expand all</button><button type="button" class="tree-btn" data-tree="collapse"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3l4 3 4-3M4 13l4-3 4 3"/></svg>Collapse all</button></div></div><p class="tree-empty" role="status" hidden>No files match.</p><div class="tree-body"><Astro.self dir={dir} current={current} /></div></div>
: <ul class="note-tree">{dir.children.map(c => c.kind === 'folder'
  ? <li><a href={c.url} aria-current={here(c.url)}>{c.name}/</a><Astro.self dir={c} current={current} /></li>
  : <li><a href={c.href} aria-current={c.kind === 'doc' && !c.name.startsWith('README.') ? here(c.url) : undefined}>{c.name}</a></li>)}</ul>}
{searchable && <script is:inline>(()=>{for(const box of document.querySelectorAll('.note-tree-search')){const input=box.querySelector('input'),empty=box.querySelector('.tree-empty'),root=box.querySelector('.note-tree'),actions=box.querySelector('.tree-actions');const folders=[...root.querySelectorAll('li')].filter(li=>li.querySelector(':scope > .note-tree'));const set=(li,open)=>{li.toggleAttribute('data-collapsed',!open);const b=li.querySelector(':scope > .tree-toggle');b.setAttribute('aria-expanded',open);b.setAttribute('aria-label',(open?'Collapse ':'Expand ')+li.firstElementChild.nextElementSibling.textContent)};for(const li of folders){const b=document.createElement('button');b.type='button';b.className='tree-toggle';b.addEventListener('click',()=>set(li,li.hasAttribute('data-collapsed')));li.prepend(b);set(li,true)}actions.hidden=false;actions.addEventListener('click',e=>{const k=e.target.closest('[data-tree]')?.dataset.tree;if(k)folders.forEach(li=>set(li,k==='expand'))});const walk=(li,q,all)=>{const sub=li.querySelector(':scope > .note-tree'),self=li.querySelector(':scope > a').textContent.toLowerCase().includes(q),kids=sub?[...sub.children]:[];const hit=kids.map(k=>walk(k,q,all||self)).some(Boolean);const show=!q||all||self||hit;li.hidden=!show;return show};input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();box.toggleAttribute('data-searching',!!q);const any=[...root.children].map(li=>walk(li,q,false)).some(Boolean);empty.hidden=!q||any})}})();</script>}
