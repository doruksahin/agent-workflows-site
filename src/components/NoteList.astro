---
import NoteRow from './NoteRow.astro';
import { groupByDate, type Note } from '../lib/notes';
interface Props { notes: Note[] }
const { notes } = Astro.props;
---
{groupByDate(notes).map(g => <section class="note-group"><h2 class="eyebrow"><time datetime={g.date.toISOString()}>{g.label}</time></h2><div class="note-rows">{g.notes.map(note => <NoteRow note={note} />)}</div></section>)}
