---
import '../styles/global.css';
import '../styles/explore.css';
const { title = 'A field guide to agent workflows', description = 'Explore the tools, understand the boundaries, and follow the evidence. A field guide to Doruk’s agent workflows.', immersive = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [['/tools/', 'Tools & repos'], ['/guides/', 'Guides'], ['/map/', 'System map']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <title>{title} · Agent Workflows</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title + ' · Agent Workflows'} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(path, Astro.site)} />
  <meta name="theme-color" content="#f6f6ef" />
</head>
<body class:list={{immersive}}>
  <a href="#main" class="skip">Skip to content</a>
  {!immersive && <header class="header shell">
    <a class="brand" href="/" aria-label="Agent Workflows home"><img src="/favicon.svg" width="32" height="32" alt="" /><span>Agent Workflows<span class="brand-sub">A field guide by Doruk</span></span></a>
    <nav aria-label="Main navigation">{nav.map(([href,label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
  </header>}
  <main id="main"><slot /></main>
  {!immersive && <footer class="footer shell"><div><a class="footer-name" href="/">Agent Workflows</a><p>Understand the tools. Follow the evidence.</p></div><div class="footer-links"><a href="/about/">About & sources</a><a href="https://github.com/doruksahin/agent-workflows-site">Website source ↗</a><a href="https://doruk.uk">doruk.uk ↗</a></div></footer>}
</body>
</html>
