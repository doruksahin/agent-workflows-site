---
import Base from './Base.astro';
import NoteTree from '../components/NoteTree.astro';
import ImageViewer from '../components/ImageViewer.astro';
import { formatDate, type Note, type TreeFolder } from '../lib/notes';
interface Props { tree: TreeFolder; current: string; crumbs: { name: string; url: string }[]; title: string; description: string; note?: Note }
const { tree, current, crumbs, title, description, note } = Astro.props;
const d = note?.data;
---
<Base title={title} description={description}><div class="shell note-layout"><details class="note-side" open><summary class="eyebrow">Files</summary><NoteTree dir={tree} current={current} /></details><script is:inline>(()=>{const side=document.currentScript.previousElementSibling,phone=matchMedia('(max-width:720px)');side.open=!phone.matches;phone.addEventListener('change',e=>{side.open=!e.matches})})();</script><article class="note-main"><header class="page-head"><div class="breadcrumb note-crumbs">{crumbs.map((c, i) => <>{i > 0 && ' / '}<a href={c.url} aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c.name}</a></>)}</div>{d && <div class="eyebrow"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>{d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></>}</div>}<h1>{title}</h1><p class="lead">{description}</p>{d && <div class="tag-list">{d.tags.map(t => <a class="badge" href={`/notes/tags/${t}/`}>{t}</a>)}</div>}</header><slot name="listing" />{d && <div class="prose" data-readme={Astro.slots.has('listing') ? '' : undefined}><slot />{d.source && <p class="reference-note">Source: {d.source}</p>}</div>}</article></div><ImageViewer /></Base>
